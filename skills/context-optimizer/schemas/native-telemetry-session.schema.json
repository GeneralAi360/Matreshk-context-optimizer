{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generalai360.github.io/matreshka-context-optimizer/schemas/native-telemetry-session.schema.json",
  "title": "Matreshka Native Telemetry Session",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "provider",
    "session_id",
    "path",
    "project",
    "usage",
    "context",
    "events"
  ],
  "properties": {
    "provider": {
      "type": "string",
      "enum": [
        "codex",
        "claude",
        "antigravity"
      ]
    },
    "session_id": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "archived": {
      "type": "boolean"
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ]
    },
    "project": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "input_tokens",
        "cached_input_tokens",
        "cache_creation_input_tokens",
        "cache_read_input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens",
        "measurement_type",
        "source",
        "measured_calls"
      ],
      "properties": {
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cached_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_creation_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "cache_read_input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "measurement_type": {
          "type": "string",
          "enum": [
            "PROVIDER_MEASURED",
            "UNKNOWN"
          ]
        },
        "source": {
          "type": "string"
        },
        "measured_calls": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "reported_context_tokens",
        "reported_context_measurement_type",
        "context_window_tokens",
        "breakdown_unit",
        "breakdown_bytes_full",
        "breakdown_bytes_effective",
        "compactions"
      ],
      "properties": {
        "reported_context_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "reported_context_measurement_type": {
          "type": "string",
          "enum": [
            "PROVIDER_MEASURED",
            "UNKNOWN"
          ]
        },
        "reported_context_semantics": {
          "type": [
            "string",
            "null"
          ]
        },
        "context_window_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "breakdown_unit": {
          "const": "bytes"
        },
        "breakdown_bytes_full": {
          "type": "object"
        },
        "breakdown_bytes_effective": {
          "type": "object"
        },
        "compactions": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tools",
        "file_reads",
        "skills",
        "mcp_tools"
      ],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "file_reads": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mcp_tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
