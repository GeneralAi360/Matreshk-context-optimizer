{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://generalai360.github.io/matreshka-context-optimizer/schemas/change.schema.json",
  "title": "Context Optimizer Reversible Change",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "change_id",
    "operation",
    "target",
    "expected_before_sha256",
    "source_finding_ids",
    "approval_required",
    "quality_risk",
    "params"
  ],
  "properties": {
    "change_id": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "REPLACE_EXACT_TEXT",
        "JSON_SET",
        "MOVE_PATH"
      ]
    },
    "target": {
      "type": "string",
      "minLength": 1
    },
    "expected_before_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_finding_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^CTX-[0-9]{3,}$"
      }
    },
    "approval_required": {
      "const": true
    },
    "quality_risk": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ]
    },
    "params": {
      "type": "object",
      "additionalProperties": true
    },
    "validation": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "REPLACE_EXACT_TEXT"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "old",
              "new",
              "expected_occurrences"
            ],
            "properties": {
              "old": {
                "type": "string"
              },
              "new": {
                "type": "string"
              },
              "expected_occurrences": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "JSON_SET"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "value"
            ],
            "properties": {
              "path": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "value": {}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "MOVE_PATH"
          }
        }
      },
      "then": {
        "properties": {
          "params": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination"
            ],
            "properties": {
              "destination": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
